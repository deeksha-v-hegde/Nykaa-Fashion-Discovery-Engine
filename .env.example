# ==========================================
# Nykaa Fashion - AI Wishlist Discovery Engine
# Environment Configuration (Phase 0 Onward)
# ==========================================

# Groq LLM Inference Settings
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding & Vector Database Settings
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DB_URL=sqlite:///./data/discovery_engine.db

# Retrieval Strategy & Depth
RETRIEVAL_STRATEGY=hybrid
RETRIEVAL_TOP_K=5

# Document Chunking Settings
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# Research Prioritisation Scoring Weights (Must sum to 1.0)
WEIGHT_FREQUENCY=0.20
WEIGHT_METRIC_RELEVANCE=0.25
WEIGHT_PAIN=0.20
WEIGHT_EVIDENCE=0.15
WEIGHT_CROSS_SOURCE=0.10
WEIGHT_SOLVABILITY=0.10

# Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
